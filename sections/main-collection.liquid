{% liquid
  assign ee_collection = collection
  assign ee_is_all = false
  if collection == blank or collection.products_count == 0
    assign ee_collection = collections.all
    assign ee_is_all = true
  endif
  if collection.handle == 'all' or collection.handle == 'frontpage'
    assign ee_is_all = true
  endif
  assign current_handle = collection.handle | default: 'all'
%}
<section class="section catalog dedicated-catalog is-open ee-collection-page" id="catalog">
  <div class="container">
    <div class="catalog-view-head">
      <a class="catalog-back" href="{{ routes.root_url }}">← Back to storefront</a>
      <div>
        <h1>{{ collection.title | default: 'Product Catalog' }}</h1>
        <p id="catalogCount">
          {% if collection.description != blank %}
            {{ collection.description | strip_html | truncate: 180 }}
          {% else %}
            Every product in the Exclusive Essence assortment — human hair, care, color, tools and more.
          {% endif %}
        </p>
      </div>
    </div>

    <div class="catalog-tools">
      {% render 'department-chips', current: current_handle %}
      <div class="catalog-actions">
        <label class="sr-only" for="SortBy">Sort</label>
        <select id="SortBy" name="sort_by" aria-label="Sort products" onchange="if(this.value) window.location.href=this.value">
          {% if collection.sort_options.size > 0 %}
            {% for option in collection.sort_options %}
              <option value="{{ collection.url }}?sort_by={{ option.value }}" {% if collection.sort_by == option.value %}selected{% endif %}>{{ option.name }}</option>
            {% endfor %}
          {% else %}
            <option value="{{ collection.url }}">Featured</option>
          {% endif %}
        </select>
      </div>
    </div>

    {% paginate ee_collection.products by 48 %}
      <p class="ee-catalog-count">{{ paginate.items }} products · Page {{ paginate.current_page }} of {{ paginate.pages }}</p>
      {% if ee_collection.products.size == 0 %}
        <div class="catalog-empty" style="display:block">
          No products in this collection yet. Browse the full store catalog while department collections are created in Shopify Admin.
          <div class="hero-actions" style="justify-content:center;margin-top:18px">
            <a class="btn btn-primary" href="{{ routes.all_products_collection_url }}">View all products</a>
          </div>
        </div>
      {% else %}
        <div class="product-shelf">
          {% for product in ee_collection.products %}
            {% render 'product-card', product: product %}
          {% endfor %}
        </div>
        <nav class="pagination" aria-label="Collection pages">
          {{ paginate | default_pagination }}
        </nav>
      {% endif %}
    {% endpaginate %}
  </div>
</section>
{% schema %}
{
  "name": "Collection",
  "settings": [
    {"type":"range","id":"per_page","min":24,"max":48,"step":8,"label":"Products per page","default":48}
  ]
}
{% endschema %}
