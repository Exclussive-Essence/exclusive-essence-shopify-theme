{%- comment -%}
  Prints a collection URL, falling back to the full catalog when the handle
  has not been created in Admin yet.
  Usage: href="{% render 'collection-url', handle: 'human-hair' %}"
{%- endcomment -%}
{%- if handle == 'all' or handle == blank -%}
  {{- routes.all_products_collection_url -}}
{%- elsif collections[handle].handle == handle -%}
  {{- collections[handle].url -}}
{%- else -%}
  {{- routes.all_products_collection_url -}}
{%- endif -%}
